# ZENZEE Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# LOCAL DEVELOPMENT (optional - defaults are provided)
SECRET_KEY=unsafe-local-dev-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Production example: https://your-app.up.railway.app,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# DATABASE (Local development uses SQLite by default)
# For production/Railway, provide PostgreSQL DATABASE_URL
DATABASE_URL=

# PAYMENT GATEWAYS - RAZORPAY (Required for checkout)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# PAYMENT GATEWAYS - STRIPE (Optional, if using Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ============================================
# RAILWAY PRODUCTION CONFIGURATION
# ============================================
# When deploying to Railway, set these in Railway Dashboard → Variables:
# 
# SECRET_KEY=<generate-a-secure-random-string>
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,*.railway.app
# DATABASE_URL=<provided-by-railway-postgres-addon>
# RAZORPAY_KEY_ID=<your-live-key>
# RAZORPAY_KEY_SECRET=<your-live-secret>
